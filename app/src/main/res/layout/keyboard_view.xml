<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/terminal_surface">

    <com.termkey.ime.KeyboardContentView
        android:id="@+id/keyboard_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Macro quick-insert bar -->
        <HorizontalScrollView
            android:id="@+id/macro_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/terminal_surface2"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/macro_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- Thin separator -->
        <View
            android:id="@+id/macro_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_border" />

        <!-- Candidate and AI tool bar -->
        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:minHeight="@dimen/macro_bar_height"
            android:scrollbars="none"
            android:background="@color/terminal_surface2"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/candidate_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- F1-F12 row -->
        <LinearLayout
            android:id="@+id/fn_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:gravity="center">

            <include layout="@layout/key_fn" android:id="@+id/key_f1"  android:tag="F1" />
            <include layout="@layout/key_fn" android:id="@+id/key_f2"  android:tag="F2" />
            <include layout="@layout/key_fn" android:id="@+id/key_f3"  android:tag="F3" />
            <include layout="@layout/key_fn" android:id="@+id/key_f4"  android:tag="F4" />
            <include layout="@layout/key_fn" android:id="@+id/key_f5"  android:tag="F5" />
            <include layout="@layout/key_fn" android:id="@+id/key_f6"  android:tag="F6" />
            <include layout="@layout/key_fn" android:id="@+id/key_f7"  android:tag="F7" />
            <include layout="@layout/key_fn" android:id="@+id/key_f8"  android:tag="F8" />
            <include layout="@layout/key_fn" android:id="@+id/key_f9"  android:tag="F9" />
            <include layout="@layout/key_fn" android:id="@+id/key_f10" android:tag="F10" />
            <include layout="@layout/key_fn" android:id="@+id/key_f11" android:tag="F11" />
            <include layout="@layout/key_fn" android:id="@+id/key_f12" android:tag="F12" />
        </LinearLayout>

        <!-- Key row 1 -->
        <LinearLayout
            android:id="@+id/key_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/key_grave"     style="@style/Key" android:text="`"  android:layout_weight="1" /><requestFocus />
            <TextView android:id="@+id/key_1"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_2"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_3"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_4"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_5"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_6"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_7"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_8"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_9"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_0"         style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_minus"     style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_equals"    style="@style/Key" android:layout_weight="1" />
            <TextView android:id="@+id/key_backspace" style="@style/Key.Wide" android:text="⌫" android:layout_weight="1.5" />
        </LinearLayout>

        <!-- Key row 2 -->
        <LinearLayout
            android:id="@+id/key_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/key_tab"       style="@style/Key.Tab"   android:text="TAB⇥" android:layout_weight="1.5" />
            <TextView android:id="@+id/key_lbracket" style="@style/Key"   android:text="[" android:layout_weight="1" />
            <TextView android:id="@+id/key_q"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_w"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_e"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_r"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_t"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_y"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_u"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_i"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_o"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_p"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_rbracket"  style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_backslash" style="@style/Key"       android:layout_weight="1" />
        </LinearLayout>

        <!-- Key row 3 -->
        <LinearLayout
            android:id="@+id/key_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/key_ctrl"      style="@style/Key.Ctrl"  android:text="CTRL"  android:layout_weight="1.5" />
            <TextView android:id="@+id/key_semicolon" style="@style/Key"  android:text=";" android:layout_weight="1" />
            <TextView android:id="@+id/key_a"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_s"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_d"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_f_key"     style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_g"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_h"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_j"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_k"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_l"         style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_quote"     style="@style/Key"       android:layout_weight="1" />
            <TextView android:id="@+id/key_enter"     style="@style/Key.Enter" android:text="↩ ENTER" android:layout_weight="2" />
        </LinearLayout>

        <!-- Key row 4 -->
        <LinearLayout
            android:id="@+id/key_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/key_esc"         style="@style/Key.Esc"  android:text="ESC"    android:layout_weight="1" />
            <TextView android:id="@+id/key_alt"         style="@style/Key.Alt"  android:text="ALT"    android:layout_weight="1" />
            <TextView android:id="@+id/key_comma"  style="@style/Key"      android:text=","      android:layout_weight="1" />
            <TextView android:id="@+id/key_z"           style="@style/Key"      android:text="z"      android:layout_weight="1" />
            <TextView android:id="@+id/key_x"           style="@style/Key"      android:text="x"      android:layout_weight="1" />
            <TextView android:id="@+id/key_c"           style="@style/Key"      android:text="c"      android:layout_weight="1" />
            <TextView android:id="@+id/key_v"           style="@style/Key"      android:text="v"      android:layout_weight="1" />
            <TextView android:id="@+id/key_b"           style="@style/Key"      android:text="b"      android:layout_weight="1" />
            <TextView android:id="@+id/key_n"           style="@style/Key"      android:text="n"      android:layout_weight="1" />
            <TextView android:id="@+id/key_m"           style="@style/Key"      android:text="m"      android:layout_weight="1" />
            <TextView android:id="@+id/key_period"      style="@style/Key"      android:text="."      android:layout_weight="1" />
            <TextView android:id="@+id/key_slash"       style="@style/Key"      android:text="/"      android:layout_weight="1" />
            <TextView android:id="@+id/key_arrow_up"    style="@style/Key.Arrow" android:text="↑"     android:layout_weight="1" />
        </LinearLayout>

        <!-- Key row 5 -->
        <LinearLayout
            android:id="@+id/key_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/key_shift"      style="@style/Key.Fn"    android:text="⇧"      android:layout_weight="1" />
            <TextView android:id="@+id/key_lang"       style="@style/Key.Mode"  android:text="EN"     android:layout_weight="1" />
            <TextView android:id="@+id/key_emoji"      style="@style/Key.Fn"    android:text="😊"     android:layout_weight="1" />
            <TextView android:id="@+id/key_one_hand"   style="@style/Key.Fn"    android:text="1H"     android:layout_weight="1" />
            <TextView android:id="@+id/key_page_up"    style="@style/Key.Fn"    android:text="PgUp"   android:layout_weight="1" />
            <TextView android:id="@+id/key_page_down"  style="@style/Key.Fn"    android:text="PgDn"   android:layout_weight="1" />
            <TextView android:id="@+id/key_home"       style="@style/Key.Fn"    android:text="Home"   android:layout_weight="1" />
            <TextView android:id="@+id/key_end"        style="@style/Key.Fn"    android:text="End"    android:layout_weight="1" />
            <TextView android:id="@+id/key_space"      style="@style/Key.Space" android:text="SPACE"  android:layout_weight="2.5" />
            <TextView android:id="@+id/key_delete"     style="@style/Key.Fn"    android:text="Del"    android:layout_weight="1" />
            <TextView android:id="@+id/key_numbers"    style="@style/Key.Fn"    android:text="123"    android:layout_weight="1" />
            <TextView android:id="@+id/key_arrow_left" style="@style/Key.Arrow" android:text="←"      android:layout_weight="1" />
            <TextView android:id="@+id/key_arrow_down" style="@style/Key.Arrow" android:text="↓"      android:layout_weight="1" />
            <TextView android:id="@+id/key_arrow_right" style="@style/Key.Arrow" android:text="→"      android:layout_weight="1" />
        </LinearLayout>

        <!-- Numeric Keypad (matches user reference image) -->
        <LinearLayout
            android:id="@+id/numeric_pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- Num Row 1: 7, 8, 9, / -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/num_7" style="@style/Key" android:text="7" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_8" style="@style/Key" android:text="8" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_9" style="@style/Key" android:text="9" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_div" style="@style/Key" android:text="/" android:textSize="22sp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Num Row 2: 4, 5, 6, * -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/num_4" style="@style/Key" android:text="4" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_5" style="@style/Key" android:text="5" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_6" style="@style/Key" android:text="6" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_mul" style="@style/Key" android:text="*" android:textSize="22sp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Num Row 3: 1, 2, 3, - -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/num_1" style="@style/Key" android:text="1" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_2" style="@style/Key" android:text="2" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_3" style="@style/Key" android:text="3" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_min" style="@style/Key" android:text="-" android:textSize="22sp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Num Row 4: ., 0, ,, + -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/num_dot" style="@style/Key" android:text="." android:textSize="24sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_0" style="@style/Key" android:text="0" android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_comma" style="@style/Key" android:text="," android:textSize="22sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_plus" style="@style/Key" android:text="+" android:textSize="22sp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Num Row 5: ABC, Space, Backspace, Done -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/num_abc" style="@style/Key.Mode" android:text="ABC" android:textSize="16sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_space" style="@style/Key.Space" android:text="SPACE" android:textSize="12sp" android:layout_weight="2.5" />
                <TextView android:id="@+id/num_backspace" style="@style/Key.Wide" android:text="⌫" android:textSize="18sp" android:layout_weight="1" />
                <TextView android:id="@+id/num_enter" style="@style/Key.Enter" android:text="Done" android:textSize="16sp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- LLM / AI tool action panel -->
        <LinearLayout
            android:id="@+id/llm_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:background="@drawable/bg_llm_panel"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/llm_panel_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="AI Assistant"
                    android:textColor="@color/terminal_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/llm_panel_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thinking..."
                    android:textColor="@color/terminal_text_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/llm_panel_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenAI"
                    android:textColor="@color/terminal_amber"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_macro_btn"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/llm_option_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llm_option_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/llm_panel_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/terminal_text"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:maxLines="4"
                android:scrollbars="vertical"
                android:background="@color/terminal_surface"
                android:padding="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/llm_action_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="@string/llm_cancel"
                    android:textColor="@color/terminal_text_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_macro_btn"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/llm_action_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="@string/llm_retry"
                    android:textColor="@color/terminal_cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_macro_btn"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/llm_action_replace"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="@string/llm_replace"
                    android:textColor="@color/terminal_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_macro_btn"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </com.termkey.ime.KeyboardContentView>
</FrameLayout>
