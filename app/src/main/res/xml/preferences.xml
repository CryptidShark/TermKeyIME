<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_category_appearance">
        <ListPreference
            android:key="keyboard_theme"
            android:title="@string/pref_keyboard_theme"
            android:entries="@array/keyboard_theme_entries"
            android:entryValues="@array/keyboard_theme_values"
            android:defaultValue="terminal_green" />
        <ListPreference
            android:key="keyboard_font"
            android:title="@string/pref_keyboard_font"
            android:entries="@array/keyboard_font_entries"
            android:entryValues="@array/keyboard_font_values"
            android:defaultValue="monospace" />
        <ListPreference
            android:key="key_text_size"
            android:title="@string/pref_key_text_size"
            android:entries="@array/key_text_size_entries"
            android:entryValues="@array/key_text_size_values"
            android:defaultValue="normal" />
        <ListPreference
            android:key="key_height"
            android:title="@string/pref_key_height"
            android:entries="@array/key_height_entries"
            android:entryValues="@array/key_height_values"
            android:defaultValue="42" />
        <SwitchPreferenceCompat
            android:key="show_fn_row"
            android:title="@string/pref_show_fn_row"
            android:summary="@string/pref_show_fn_row_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="show_macro_bar"
            android:title="@string/pref_show_macro_bar"
            android:summary="@string/pref_show_macro_bar_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="vibrate_on_keypress"
            android:title="@string/pref_vibrate"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="sound_on_keypress"
            android:title="@string/pref_sound"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_custom_colors">
        <EditTextPreference
            android:key="custom_surface_color"
            android:title="@string/pref_custom_surface_color"
            android:defaultValue="#0D1117" />
        <EditTextPreference
            android:key="custom_key_bg_color"
            android:title="@string/pref_custom_key_bg_color"
            android:defaultValue="#21262D" />
        <EditTextPreference
            android:key="custom_text_color"
            android:title="@string/pref_custom_text_color"
            android:defaultValue="#FFFFFF" />
        <EditTextPreference
            android:key="custom_accent_color"
            android:title="@string/pref_custom_accent_color"
            android:defaultValue="#00FF66" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_behavior">
        <ListPreference
            android:key="input_language"
            android:title="@string/pref_input_language"
            android:entries="@array/input_language_entries"
            android:entryValues="@array/input_language_values"
            android:defaultValue="en" />
        <SwitchPreferenceCompat
            android:key="swipe_typing_enabled"
            android:title="@string/pref_swipe_typing"
            android:summary="@string/pref_swipe_typing_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="sticky_modifiers"
            android:title="@string/pref_sticky_mod"
            android:summary="@string/pref_sticky_mod_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="swipe_for_symbols"
            android:title="@string/pref_swipe"
            android:summary="@string/pref_swipe_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="long_press_extra"
            android:title="@string/pref_long_press"
            android:summary="@string/pref_long_press_summary"
            android:defaultValue="true" />
    </PreferenceCategory>



    <PreferenceCategory android:title="@string/pref_category_llm">
        <SwitchPreferenceCompat
            android:key="llm_enabled"
            android:title="@string/pref_show_llm_tools"
            android:summary="@string/pref_show_llm_tools_summary"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="llm_base_url"
            android:title="@string/pref_llm_base_url"
            android:summary="@string/pref_llm_base_url_summary"
            android:defaultValue="https://api.openai.com/v1" />
        <EditTextPreference
            android:key="llm_api_key"
            android:title="@string/pref_llm_api_key"
            android:summary="@string/pref_llm_api_key_summary" />
        <EditTextPreference
            android:key="llm_model"
            android:title="@string/pref_llm_model"
            android:summary="@string/pref_llm_model_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_macros">
        <Preference
            android:key="edit_macros"
            android:title="@string/pref_edit_macros"
            android:summary="@string/pref_edit_macros_summary" />
        <Preference
            android:key="reset_macros"
            android:title="@string/pref_reset_macros" />
    </PreferenceCategory>

</PreferenceScreen>
